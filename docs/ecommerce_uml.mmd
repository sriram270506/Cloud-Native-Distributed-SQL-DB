classDiagram
  direction LR
  class Customer {
    +int customer_id
    +string first_name
    +string last_name
    +string email
    +string status
    +date created_at
    +placeOrder() Order
  }
  class Address {
    +int address_id
    +string line1
    +string city
    +string state
    +string postal_code
    +string type
  }
  class Product {
    +int product_id
    +string product_name
    +string category
    +decimal unit_price
    +int stock_qty
    +restock(qty)
  }
  class Order {
    +int order_id
    +date order_date
    +decimal total_amount
    +string status
    +addItem(product, qty)
    +total() decimal
  }
  class OrderItem {
    +int order_item_id
    +int quantity
    +decimal unit_price
    +decimal line_total
  }
  class Payment {
    +int payment_id
    +string method
    +decimal amount
    +date paid_at
    +string status
    +string transaction_ref
  }
  Customer "1" *-- "0..*" Address : owns
  Customer "1" --> "0..*" Order : places
  Order "1" *-- "1..*" OrderItem : contains
  OrderItem "0..*" --> "1" Product : refers to
  Order "1" --> "0..*" Payment : settled by
